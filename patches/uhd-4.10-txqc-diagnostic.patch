+const char* txqc_env(const char* name)
+{
+    const char* v = std::getenv(name);
+    return (v != nullptr && *v != '\0') ? v : nullptr;
+}
+
+bool txqc_flag(const char* name)
+{
+    const char* v = txqc_env(name);
+    return v != nullptr && std::string(v) == "1";
+}
+
+void txqc_append(const std::string& line)
+{
+    const char* path = txqc_env("UHD_TXQC_LOG");
+    if (path == nullptr) {
+        return;
+    }
+    FILE* f = std::fopen(path, "a");
+    if (f == nullptr) {
+        return;
+    }
+    std::fputs(line.c_str(), f);
+    std::fputc('\n', f);
+    std::fclose(f);
+}
+} // namespace
