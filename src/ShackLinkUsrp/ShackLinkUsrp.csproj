<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sidecar executable: the protocol server (from the MIT library in ShackLink) hosting a
       radio backend (UHD or synthetic) and the DSP pipelines. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>ShackLinkUsrp</RootNamespace>
    <AssemblyName>ShackLinkUsrp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShackLinkUsrp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- AnyCPU, whatever this project builds as: the configuration follows (Directory.Build.props). -->
    <ProjectReference Include="$(UsrpProtocolProject)" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="$(IioProject)" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\ShackLinkUsrp.Uhd\ShackLinkUsrp.Uhd.csproj" />
    <ProjectReference Include="..\ShackLinkUsrp.Dsp\ShackLinkUsrp.Dsp.csproj" />
  </ItemGroup>
</Project>
