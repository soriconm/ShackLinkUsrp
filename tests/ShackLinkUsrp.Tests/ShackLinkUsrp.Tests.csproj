<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sidecar's gate: exit 0 = all pass, 1 = a failure. Drives the DSP against reference
       implementations and the real host over loopback with the synthetic source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>ShackLinkUsrp.Tests</RootNamespace>
    <!-- The sidecar runs culture-invariant; its gate runs under de-DE so a culture-sensitive
         number anywhere in the code it drives fails here. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- AnyCPU, whatever this project builds as: the configuration follows (Directory.Build.props). -->
    <ProjectReference Include="$(UsrpProtocolProject)" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="$(IioProject)" SetPlatform="Platform=AnyCPU" />
    <ProjectReference Include="..\..\src\ShackLinkUsrp.Dsp\ShackLinkUsrp.Dsp.csproj" />
    <ProjectReference Include="..\..\src\ShackLinkUsrp\ShackLinkUsrp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ONE fake board for every gate (ShackLink docs/plutosdr_support.md section 9.15, P4b): ShackLink's IiodWireTest\FakeIiod.cs
         (MIT, written from section 2.3 and the owner's board's replies, never from libiio) and the owner's Pluto's own PRINT,
         LINKED by relative path exactly as the protocol library is - never copied, so the two gates cannot drift apart. -->
    <Compile Include="$(ShackLinkDir)IiodWireTest\FakeIiod.cs" Link="FakeIiod.cs" />
    <None Include="$(ShackLinkDir)IiodWireTest\Fixtures\pluto-7020-context.xml" Link="Fixtures\pluto-7020-context.xml" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="IiodWireTest" />
  </ItemGroup>
</Project>
